# PostgreSQL container settings for compose.yaml.
# Copy to .env (git-ignored) and replace the password. Never commit real values.
# Generate a password with:  python3 -c "import secrets; print(secrets.token_urlsafe(24))"

POSTGRES_USER=ecopantry
POSTGRES_PASSWORD=replace-with-a-generated-password
POSTGRES_DB=ecopantry

# Host port, bound to 127.0.0.1 only. Change it if 5432 is already in use.
POSTGRES_PORT=5432
