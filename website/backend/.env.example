# Copy to .env (git-ignored) in this directory. Never commit real values.

# development | test | production. API docs (/api/v1/docs) are off in production.
ENVIRONMENT=development

# PostgreSQL connection. Use the same user, password, database and port as the
# repository-root .env that compose.yaml reads. postgresql:// URLs are accepted
# and use the psycopg 3 driver.
DATABASE_URL=postgresql+psycopg://ecopantry:replace-with-the-password-from-root-env@127.0.0.1:5432/ecopantry

# Optional connection pool tuning (defaults shown).
# DATABASE_POOL_SIZE=5
# DATABASE_MAX_OVERFLOW=10
# DATABASE_POOL_TIMEOUT=10
# DATABASE_CONNECT_TIMEOUT=5

# LOG_LEVEL=INFO

# Staff sessions (defaults shown). See docs/AUTH_DESIGN.md.
# SESSION_IDLE_TIMEOUT_MINUTES=60
# SESSION_ABSOLUTE_TIMEOUT_HOURS=12
# Secure cookies need HTTPS. Unset means: Secure only when ENVIRONMENT=production
# (and production refuses false).
# SESSION_COOKIE_SECURE=
# LOGIN_MAX_FAILED_ATTEMPTS=5
# LOGIN_LOCKOUT_MINUTES=15

# Sensor stations (defaults shown). See docs/HARDWARE_INTEGRATION.md.
# A station only uploads during a live session; idle stations send nothing.
# LIVE_SESSION_MINUTES=15
# DEVICE_BOOT_SESSION_MINUTES=5
# DEVICE_DAILY_LIVE_MINUTES=240
# DEVICE_REPORT_INTERVAL_SECONDS=3
# DEVICE_MIN_REPORT_INTERVAL_SECONDS=2
