# Copy to .env.local for local development. Never commit real values.
# Only VITE_-prefixed variables reach the browser, so never put secrets here.

# Base URL of the FastAPI backend, including the version prefix.
# Leave unset in development: it defaults to /api/v1 on the same origin, and the
# Vite dev server proxies that to FastAPI, so session cookies stay same-origin.
# VITE_API_BASE_URL=/api/v1

# Where the dev server (and `npm run preview`) forwards /api/v1.
# Read by vite.config.ts only; never sent to the browser.
API_PROXY_TARGET=http://127.0.0.1:8000

# Development-only portal preview: a fake session with a role switcher, for
# reviewing layouts without a backend or an account. It has no session cookie,
# so the API refuses all its requests. Ignored by production builds. Leave it
# false to use real sign-in against the backend.
VITE_PORTAL_PREVIEW=false

# Development only: serve the dev server over HTTPS with a self-signed certificate.
# The QR scanner's camera needs HTTPS (or localhost), so set this to try the scanner
# from a phone on the same network: `npm run dev -- --host`, then open
# https://<this computer's LAN address>:5173 and accept the certificate warning.
# Read by vite.config.ts only. Not used by production builds.
DEV_HTTPS=false
