# Copy to .env.local for local development. Never commit real values.
# Only VITE_-prefixed variables reach the browser, so never put secrets here.

# Base URL of the FastAPI backend, including the version prefix.
# Leave unset in development: it defaults to /api/v1 on the same origin, and the
# Vite dev server proxies that to FastAPI, so session cookies stay same-origin.
# VITE_API_BASE_URL=/api/v1

# Where the dev server (and `npm run preview`) forwards /api/v1.
# Read by vite.config.ts only; never sent to the browser.
API_PROXY_TARGET=http://127.0.0.1:8000

# Development-only portal preview (no authentication, no data).
# Ignored by production builds. Real sign-in replaces this in Milestone 3.
VITE_PORTAL_PREVIEW=false
